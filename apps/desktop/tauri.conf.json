{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Screen Recorder",
  "identifier": "dev.screenrecorder.desktop",
  "build": { "frontendDist": "../../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "label": "main", "title": "Screen Recorder", "width": 1080, "height": 920, "minWidth": 620, "minHeight": 440, "visible": false }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; media-src 'self' asset: http://asset.localhost blob:",
      "assetProtocol": { "enable": true, "scope": [] },
      "capabilities": [{ "identifier": "desktop", "windows": ["main", "selection", "capture-controls"], "permissions": ["core:event:default", "core:window:allow-set-focus", "core:window:allow-show", "core:window:allow-hide"] }]
    }
  },
  "bundle": { "active": false, "icon": [] }
}
